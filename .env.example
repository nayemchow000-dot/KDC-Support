# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ====================================================================
# Supabase Frontend Environment Variables (Required)
# ====================================================================
# Obtain these from your Supabase Project Settings -> API (or Project Overview -> Connect)
# 1. Project URL:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 2. Publishable Key (browser-safe, enforced by Row Level Security):
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"

# NOTE:
# SUPABASE_SECRET_KEY / SERVICE_ROLE_KEY is NOT required for this application
# because all operations use Row Level Security (RLS) and Supabase Auth.
# Never expose secret keys in client code or prefix them with VITE_.
