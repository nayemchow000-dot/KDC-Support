{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representing a customer or an admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["customer", "admin"], "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "lastLoginAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "role"]
    },
    "Device": {
      "title": "Device",
      "description": "Registered customer mobile or desktop device record",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "deviceName": { "type": "string", "maxLength": 128 },
        "deviceModel": { "type": "string", "maxLength": 128 },
        "browserInfo": { "type": "string", "maxLength": 256 },
        "platform": { "type": "string", "maxLength": 64 },
        "connectionStatus": { "type": "string", "enum": ["connected", "offline"], "maxLength": 32 },
        "lastSeen": { "type": "string", "maxLength": 64 },
        "appVersion": { "type": "string", "maxLength": 32 },
        "permissionStatus": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["deviceId", "userId", "connectionStatus"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator designation",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "grantedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records accessible by owner or admins"
    },
    "/devices/{deviceId}": {
      "schema": "Device",
      "description": "Customer devices registered and monitored by support admins"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "List of authorized administrator identifiers"
    }
  }
}
