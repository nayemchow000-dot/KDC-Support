rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nayemchow000@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 2. Admins collection
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 3. Users collection (Customer profile isolation)
    match /users/{userId} {
      allow get: if isValidId(userId) && (resource == null || isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.keys().hasAll(['uid', 'role']) &&
        (request.resource.data.role == 'customer' || isAdmin());
      allow update: if isValidId(userId) && (
        (isOwner(userId) && request.resource.data.uid == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 4. Devices collection
    match /devices/{deviceId} {
      allow get: if isValidId(deviceId) && (
        resource == null ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if (
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isValidId(deviceId) && isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['deviceId', 'userId', 'connectionStatus']);
      allow update: if isValidId(deviceId) && (
        (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isValidId(deviceId) && (
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}
